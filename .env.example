# Credenciales de los contenedores de desarrollo local (docker-compose.yml).
# Solo se usan en tu máquina: en producción la base de datos es un servicio
# gestionado y estas variables no existen.
#
# Copia este archivo a `.env` en la raíz del repositorio:
#   cp .env.example .env

# Usuario, contraseña y nombre de la base de datos que creará el contenedor.
# Puedes inventarlos: nadie más los usa. Deben coincidir con el DATABASE_URL
# de apps/api/.env.
POSTGRES_USER=sion
POSTGRES_PASSWORD=sion
POSTGRES_DB=sion

# Puerto de tu máquina donde se publica Postgres.
# Cámbialo si ya tienes otro Postgres ocupando el 5432.
POSTGRES_PORT=5432

# Puerto donde se publica Adminer, para abrirlo en el navegador.
ADMINER_PORT=8080
