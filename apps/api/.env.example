# Configuración del backend.
# Copia este archivo a `apps/api/.env`:  cp apps/api/.env.example apps/api/.env
#
# El API valida todo esto al arrancar. Si falta o es inválida una variable, el
# proceso NO arranca y te dice cuál es. Los valores nunca se imprimen.

# ─── Servidor ────────────────────────────────────────────────────────────────

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto donde escucha el API. En producción lo suele imponer el host.
PORT=3000

# ─── Base de datos ───────────────────────────────────────────────────────────

# Cadena de conexión a PostgreSQL. En local debe coincidir con el usuario,
# contraseña, puerto y nombre de base de datos del `.env` de la raíz.
# En producción te la da tu proveedor (Neon, Supabase, Railway...) ya montada.
DATABASE_URL=postgresql://sion:sion@localhost:5432/sion?schema=public

# Milisegundos que espera la comprobación de salud antes de dar la base de
# datos por inalcanzable. Evita que /health se quede colgado.
HEALTH_DB_TIMEOUT_MS=2000

# ─── Seguridad ───────────────────────────────────────────────────────────────

# Origen EXACTO del frontend autorizado a llamar al API con credenciales.
# En local es la URL de Vite; en producción, la de tu despliegue en Vercel.
# Nunca uses `*`: con cookies de sesión el navegador lo rechaza.
CORS_ORIGIN=http://localhost:5173

# Coste de bcrypt al cifrar contraseñas. 12 es un buen valor de producción.
# En pruebas conviene bajarlo (4) para que no tarden.
BCRYPT_ROUNDS=12

# ─── Siembra del administrador original ──────────────────────────────────────
# Solo las lee `pnpm db:seed`. El servidor NO las necesita para arrancar, así
# que en producción pueden vivir únicamente donde ejecutes la siembra.

# Identidad del admin original. Es la clave por la que el seed lo reconoce:
# si la cambias después de sembrar, el seed aborta en vez de crear un segundo
# administrador.
SEED_ADMIN_DOCUMENT_TYPE=CC
SEED_ADMIN_DOCUMENT_NUMBER=1000000000

# Correo y contraseña con los que entrará el admin original.
# Cambiarlos y volver a sembrar actualiza la cuenta existente, no crea otra.
SEED_ADMIN_EMAIL=admin@unac.edu.co
SEED_ADMIN_PASSWORD=cambiame-en-produccion
