# Configuración del backend.
# Copia este archivo a `apps/api/.env`:  cp apps/api/.env.example apps/api/.env
#
# El API valida todo esto al arrancar. Si falta o es inválida una variable, el
# proceso NO arranca y te dice cuál es. Los valores nunca se imprimen.

# ─── Servidor ────────────────────────────────────────────────────────────────

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto donde escucha el API. En producción lo suele imponer el host.
PORT=3000

# ─── Base de datos ───────────────────────────────────────────────────────────

# Cadena de conexión a PostgreSQL. En local debe coincidir con el usuario,
# contraseña, puerto y nombre de base de datos del `.env` de la raíz.
# En producción te la da tu proveedor (Neon, Supabase, Railway...) ya montada.
DATABASE_URL=postgresql://sion:sion@localhost:5432/sion?schema=public

# Milisegundos que espera la comprobación de salud antes de dar la base de
# datos por inalcanzable. Evita que /health se quede colgado.
HEALTH_DB_TIMEOUT_MS=2000

# ─── Seguridad ───────────────────────────────────────────────────────────────

# Origen EXACTO del frontend autorizado a llamar al API con credenciales.
# En local es la URL de Vite; en producción, la de tu despliegue en Vercel.
# Nunca uses `*`: con cookies de sesión el navegador lo rechaza.
CORS_ORIGIN=http://localhost:5173

# Coste de bcrypt al cifrar contraseñas. 12 es un buen valor de producción.
# En pruebas conviene bajarlo (4) para que no tarden.
BCRYPT_ROUNDS=12

# ─── Siembra del administrador original ──────────────────────────────────────
# Solo las lee `pnpm db:seed`. El servidor NO las necesita para arrancar, así
# que en producción pueden vivir únicamente donde ejecutes la siembra.

# Identidad del admin original. Es la clave por la que el seed lo reconoce:
# si la cambias después de sembrar, el seed aborta en vez de crear un segundo
# administrador.
SEED_ADMIN_DOCUMENT_TYPE=CC
SEED_ADMIN_DOCUMENT_NUMBER=1000000000

# Correo y contraseña con los que entrará el admin original.
# Cambiarlos y volver a sembrar actualiza la cuenta existente, no crea otra.
SEED_ADMIN_EMAIL=admin@unac.edu.co
SEED_ADMIN_PASSWORD=cambiame-en-produccion

# ─── Sesión ──────────────────────────────────────────────────────────────────

# Secreto con el que se firma la sesión. NO tiene valor por defecto a propósito:
# un default sería una firma que cualquiera con el repositorio puede reproducir.
# Genera uno aleatorio de 32+ caracteres, distinto en cada entorno:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-cadena-aleatoria-de-32-o-mas

# Duración de la sesión. No se renueva sola: al caducar hay que volver a entrar.
JWT_EXPIRES_IN=2h

# Nombre de la cookie de sesión.
COOKIE_NAME=sion_session

# ⚠ Estas dos valen DISTINTO en local y en producción, y por eso son variables:
#
#   local        COOKIE_SECURE=false   COOKIE_SAMESITE=lax
#   producción   COOKIE_SECURE=true    COOKIE_SAMESITE=none
#
# En local el front y el API son el mismo sitio (ambos en localhost) y `secure`
# sobre HTTP haría que el navegador descartara la cookie. En producción están en
# dominios distintos y hace falta `none`, que a su vez EXIGE `secure`.
#
# El API comprueba esa coherencia al arrancar: si pones `none` sin `secure`, no
# arranca. Es mucho mejor que descubrirlo en producción con el ingreso
# respondiendo bien y la petición siguiente llegando sin sesión.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ─── Políticas de tratamiento de datos ───────────────────────────────────────

# Versión vigente de las políticas. Se guarda con cada registro, de modo que
# quede constancia de qué texto aceptó cada persona. Súbela al cambiar el texto
# en apps/web/src/routes/public-routes.tsx.
POLICY_VERSION=2026-01

# ─── Base de datos de pruebas ────────────────────────────────────────────────

# Las pruebas de integración escriben y borran cuentas, así que corren contra su
# PROPIO esquema y no contra el de desarrollo. Sin esto, `pnpm test` se lleva por
# delante el administrador de tu base de datos local.
# Prisma crea el esquema solo la primera vez que migra.
TEST_DATABASE_URL=postgresql://sion:sion@localhost:5433/sion?schema=test

# ─── Almacenamiento de documentos (S3) ───────────────────────────────────────
# El bucket guarda documentos de identidad. Debe estar CERRADO al público: todo
# acceso se concede con permisos firmados que caducan.
#
# Cómo montarlo está documentado en el README. Comprueba la configuración con:
#   pnpm --filter @repo/api run s3:check

S3_REGION=us-east-1
S3_BUCKET=nombre-de-tu-bucket

# Credenciales del usuario de servicio. SECRETAS: nunca se imprimen ni se
# versionan. Debe tener permiso solo sobre este bucket, y solo para leer,
# escribir y borrar objetos.
S3_ACCESS_KEY_ID=AKIA...
S3_SECRET_ACCESS_KEY=...

# Vacío con AWS. Solo se fija al usar almacenamiento compatible con S3, que
# además suele necesitar S3_FORCE_PATH_STYLE=true.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Cuánto vive un permiso de subida o de lectura. Corto a propósito: es lo que
# impide que compartir un enlace dé acceso permanente a una cédula escaneada.
S3_PRESIGN_EXPIRES_SECONDS=300

# Tamaño máximo por archivo adjunto. 5 MB.
MAX_UPLOAD_BYTES=5242880

# ─── Recibo de pago ──────────────────────────────────────────────────────────
# Días desde la emisión hasta el vencimiento del recibo.
RECEIPT_DUE_DAYS=15
