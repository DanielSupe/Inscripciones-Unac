// Esquema de la plataforma SION.
//
// En este change solo existe `User`. Los modelos de inscripción, documentos,
// recibos y periodos académicos llegan en los changes siguientes.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 ya no admite `url` aquí: la cadena de conexión vive en
// `prisma.config.ts`, y el cliente la recibe a través de un adaptador.
datasource db {
  provider = "postgresql"
}

/// Permisos del usuario. Nunca representa el avance del proceso de inscripción:
/// eso vive en el estado de la inscripción, y son campos separados a propósito.
/// Solo se llega a STUDENT como efecto de aprobar una inscripción.
enum Role {
  APPLICANT
  STUDENT
  ADMIN
  DEAN
}

enum DocumentType {
  CC
  TI
  CE
  PA
  PEP
}

/// Avance de la inscripción. Es un eje distinto del rol: nadie llega a STUDENT
/// por editar un campo, sino como efecto de que esta máquina llegue a APPROVED.
enum EnrollmentStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  /// Entregada por el administrador; espera que su decano le ponga fecha.
  PENDING_INTERVIEW
  INTERVIEW_SCHEDULED
  /// La entrevista ocurrió; solo entonces el decano puede decidir.
  INTERVIEW_HELD
  APPROVED
  REJECTED
}

/// Dónde ocurre la entrevista. Cada modalidad exige su propio dato de acceso.
enum InterviewModality {
  ON_SITE
  VIRTUAL
}

/// Cómo terminó. Nulo mientras la cita sigue en pie.
enum InterviewOutcome {
  HELD
  NO_SHOW
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum Shift {
  DAY
  NIGHT
}

enum Modality {
  ON_SITE
  DISTANCE
}

enum AttachmentType {
  IDENTITY
  ICFES
  DIPLOMA
}

/// Eje del pago, independiente del avance de la inscripción. Aprobar exige que
/// esté en VERIFIED, pero el pago avanza por su cuenta.
enum PaymentStatus {
  PENDING
  VERIFIED
}

model User {
  id             String       @id @default(cuid())
  documentType   DocumentType
  documentNumber String
  email          String       @unique
  passwordHash   String
  role           Role         @default(APPLICANT)

  /// Marca la cuenta de administrador original creada por el seed. Ningún flujo
  /// puede eliminarla, desactivarla ni cambiarle el rol.
  isSystem Boolean @default(false)

  /// El MVP no verifica el correo, pero la columna existe desde ya para no
  /// forzar una migración cuando se añada la verificación.
  emailVerifiedAt DateTime?

  /// Evidencia de qué versión de las políticas de tratamiento de datos aceptó
  /// esta persona y cuándo (Ley 1581 de 2012). Nulables porque el administrador
  /// original lo crea el seed y no pasa por el registro.
  acceptedPolicyVersion String?
  acceptedPolicyAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Borrado lógico. Los usuarios nunca se eliminan físicamente porque de ellos
  /// cuelgan inscripciones y recibos.
  deletedAt DateTime?

  enrollments         Enrollment[]
  reviewedEnrollments Enrollment[]     @relation("EnrollmentReviewer")
  decidedEnrollments  Enrollment[]     @relation("EnrollmentDecider")
  verifiedReceipts    PaymentReceipt[] @relation("ReceiptVerifier")
  scheduledInterviews Interview[]      @relation("InterviewScheduler")
  /// La facultad que dirige, si es decano. La relación vive en Faculty porque
  /// una facultad sin decano es un estado que interesa consultar.
  ledFaculty          Faculty?         @relation("FacultyDean")

  /// La identidad real de una persona es su documento. El índice único está en
  /// la base de datos, no solo en el service: la validación da el buen mensaje,
  /// pero la garantía es esta.
  @@unique([documentType, documentNumber])
  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

/// Facultad. Agrupa programas y tiene como mucho un decano.
///
/// La relación con el decano vive aquí y es única en las dos direcciones: nadie
/// dirige dos facultades, y una facultad no tiene dos decanos. Una facultad sin
/// decano es válida pero bloquea a sus aspirantes, y por eso interesa poder
/// consultarla.
model Faculty {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  isActive Boolean @default(true)

  deanUserId String? @unique
  dean       User?   @relation("FacultyDean", fields: [deanUserId], references: [id])

  programs AcademicProgram[]

  @@map("faculties")
}

/// Programa al que se puede aspirar. Se siembra; no hay CRUD.
model AcademicProgram {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  /// Sale de oferta sin borrarse, para no romper las inscripciones que lo eligieron.
  isActive Boolean @default(true)

  /// Obligatoria: es el vínculo por el que una inscripción encuentra a su
  /// decano. Un programa sin facultad daría inscripciones que no llegan a nadie.
  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id])

  enrollments Enrollment[]

  @@index([facultyId])
  @@map("academic_programs")
}

/// Ventana de inscripción de un semestre, con su tarifa. El CRUD llega en el
/// change de la consola de administración; aquí se siembra.
model AcademicPeriod {
  id                  String   @id @default(cuid())
  code                String   @unique
  opensAt             DateTime
  closesAt            DateTime
  /// Valor del derecho de inscripción vigente. Se copia al recibo al emitirlo.
  enrollmentFeeAmount Decimal  @db.Decimal(12, 2)
  currency            String   @default("COP")
  isActive            Boolean  @default(true)

  /// Consecutivo de recibos de este periodo. Se incrementa con un UPDATE
  /// atómico, no leyendo y sumando en la aplicación: dos envíos simultáneos
  /// leerían el mismo valor y producirían el mismo número de recibo.
  receiptCounter Int @default(0)

  enrollments Enrollment[]

  @@map("academic_periods")
}

model Enrollment {
  id        String           @id @default(cuid())
  userId    String
  programId String?
  periodId  String
  status    EnrollmentStatus @default(DRAFT)

  /// Casi todos los campos son nulables a propósito: el wizard guarda en cada
  /// paso, así que un borrador está incompleto por definición. Lo que exige que
  /// estén llenos es la transición de envío, no la columna.
  firstName  String?
  lastName   String?
  birthDate  DateTime?
  sex        Sex?
  phone      String?
  city       String?
  department String?

  shift    Shift?
  modality Modality?

  submittedAt DateTime?

  /// Quién la revisó y la entregó: el administrador. Separado de quién decidió,
  /// porque desde este change son dos personas distintas y perder cualquiera de
  /// los dos rastros borraría el reparto de responsabilidad.
  reviewedAt       DateTime?
  reviewedByUserId String?

  /// Quién la aprobó o la rechazó tras la entrevista: el decano.
  decidedAt       DateTime?
  decidedByUserId String?

  /// Solo el motivo del último rechazo: se decidió no guardar historial.
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id])
  program  AcademicProgram? @relation(fields: [programId], references: [id])
  period   AcademicPeriod   @relation(fields: [periodId], references: [id])
  reviewer User?            @relation("EnrollmentReviewer", fields: [reviewedByUserId], references: [id])
  decider  User?            @relation("EnrollmentDecider", fields: [decidedByUserId], references: [id])

  attachments EnrollmentAttachment[]
  receipt     PaymentReceipt?
  interviews  Interview[]

  /// Una inscripción por aspirante y periodo. Un rechazo en un semestre no
  /// impide intentarlo en el siguiente.
  @@unique([userId, periodId])
  @@index([status])
  @@index([periodId, status])
  @@map("enrollments")
}

model EnrollmentAttachment {
  id           String         @id @default(cuid())
  enrollmentId String
  type         AttachmentType
  /// Clave del objeto en el almacenamiento. La compone el servidor; el cliente
  /// nunca la propone, porque proponerla sería poder escribir donde no le toca.
  storageKey   String
  contentType  String
  sizeBytes    Int
  uploadedAt   DateTime       @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  /// Adjuntar de nuevo el mismo tipo sustituye; no acumula.
  @@unique([enrollmentId, type])
  @@map("enrollment_attachments")
}

model PaymentReceipt {
  id            String @id @default(cuid())
  enrollmentId  String @unique
  receiptNumber String @unique

  /// El valor se copia del periodo al emitir, en vez de leerse por relación: un
  /// recibo tiene valor probatorio y no puede cambiar porque alguien edite una
  /// tarifa después.
  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("COP")

  issuedAt DateTime      @default(now())
  dueAt    DateTime
  status   PaymentStatus @default(PENDING)

  verifiedAt       DateTime?
  verifiedByUserId String?

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  verifier   User?      @relation("ReceiptVerifier", fields: [verifiedByUserId], references: [id])

  @@map("payment_receipts")
}

/// Entrevista de admisión.
///
/// Es una entidad y no un par de campos en la inscripción porque tiene
/// historia: se mueve, alguien no aparece, se vuelve a citar. Esa historia es
/// justo lo que después justifica una decisión, y un par de campos la perdería
/// en cuanto la fecha nueva pisara a la anterior.
///
/// La vigente es la única con `outcome` nulo. Que no haya dos abiertas a la vez
/// lo hace cumplir el service al crearla.
model Interview {
  id           String @id @default(cuid())
  enrollmentId String

  /// En UTC, como todo. Se presenta en la hora de Colombia.
  scheduledAt DateTime
  modality    InterviewModality
  /// Uno de los dos según la modalidad; el esquema compartido exige el que toca.
  location    String?
  meetingUrl  String?

  outcome  InterviewOutcome?
  closedAt DateTime?

  scheduledByUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollment  Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  scheduledBy User       @relation("InterviewScheduler", fields: [scheduledByUserId], references: [id])

  /// Encontrar la vigente sin recorrer el historial.
  @@index([enrollmentId, outcome])
  @@map("interviews")
}
